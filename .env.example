# Server-side only. Obtain from the user's fal account/secret manager.
# Never prefix a credential with VITE_. Do not commit a real .env.
MINIMAX_API_KEY=
FAL_KEY=

# Agent-managed onboarding. Choose ONE source for the story credentials:
# A) Point at the private handoff from Story Kernel onboarding (recommended).
# STORY_HANDOFF_PATH=/absolute/path/to/handoff.json
# Or register it once: npm run setup -- --handoff /absolute/path/to/handoff.json
# B) Supply the same identity bundle entirely through server/agent environment variables.
# STORY_EVD_ID=
# STORY_SETUP_TOKEN=
# STORY_RENDERER_ID=
# STORY_CREDENTIAL_ID=
# STORY_CLIENT_SECRET=
# STORY_ENVIRONMENT=edge
# Story type is independent of the video model/provider. Match the authored EVD type.
# STORY_TYPE=MINIMAX
# CREATOR and WHISPERS are also supported; omitted STORY_TYPE retains the CREATOR CLI default.
# STORY_ROOM_NAME=My story
# STORY_RESOLUTION=480P
# STORY_CLIP_SECONDS=6
# STORY_RENDERER_VERSION=h3.opensource.v1.0
# STORY_CONFIG_JSON={}
# STORY_RENDERER_CONFIG_JSON={"model":"fal-max-ref2v","continuity":"camera-anchors","concurrency":2,"maxBufferedSeconds":30}
# STORY_SHOT_PLANNER_JSON={"sets":{"hotel lobby":{"imageUrl":"https://example.com/approved-lobby.jpg"}}}
# STORY_INITIAL_IMAGE_URL=https://example.com/approved-start-frame.jpg
# STORY_JSON={...already-provisioned inactive story...}
# All story variables stay private. Never place them in VITE_ variables.
# After setup: npm run story -- start (or stop). No browser form or repeated handoff flag.
# Restart the local worker after updating .env so its account readiness is refreshed.

# Local defaults require no edits. npm run setup discovers Story Kernel Docker ports.
# Hosted workers receive their fal/operator credentials via npm run deploy:fly or hosted:prepare.
# PORT=4173
# MEDIA_PORT=4174
# HOST=127.0.0.1
# MEDIA_HOST=127.0.0.1
# FFMPEG_PATH=ffmpeg
# FAL_VIDEO_MODEL_ID=minimax/h3-max-turbo/text-to-video
# FAL_REFERENCE_VIDEO_MODEL_ID=minimax/h3-max/reference-to-video
# FAL_QUEUE_BASE_URL=https://queue.fal.run
# MEDIA_RELAY_RTSP_BASE_URL=rtsp://127.0.0.1:8554
# MEDIA_RELAY_HLS_BASE_URL=http://127.0.0.1:8888
# MEDIA_RELAY_AUDIENCE_DELAY_SECONDS=3

# Keep the normalized clips after a run and concatenate them into final.mp4.
# Off unless set to exactly 1; a retained run leaves media in the system temp directory.
# PICKFORD_KEEP_MEDIA=1

# Advanced: hosted kernel or discovery overrides (service origins, not credentials).
# NARRATIVE_ENGINE_URL=https://show.example.com
# RENDERER_PLATFORM_URL=https://renderer.example.com
# NARRATIVE_AUTHORING_URL=https://authoring.example.com
# REALTIME_GATEWAY_URL=https://realtime.example.com
# CHAT_BACKEND_URL=https://chat.example.com

# Fly and Render derive the shared viewer/media URL from their platform environment.
# Docker VMs receive PUBLIC_APP_URL from the agent-managed Compose configuration.
# PUBLIC_APP_URL=https://stories.example.com
# Advanced media-only override (usually unnecessary):
# PUBLIC_MEDIA_BASE_URL=https://worker.example.com/hls
# RENDERER_ADMIN_TOKEN=generated-random-secret

# Direct MiniMax and optional diagnostic bridge configuration.
MINIMAX_API_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL_ID=MiniMax-H3-Max
MINIMAX_REFERENCE_VIDEO_MODEL_ID=MiniMax-H3

# Optional local Renderer Platform bridge. Credentials stay server-side.
RENDERER_PLATFORM_BASE_URL=http://host.docker.internal:8193
RENDERER_PLATFORM_WEBSOCKET_URL=ws://host.docker.internal:8193/api/v1/renderer-bridge/ws
RENDERER_PLATFORM_ENVIRONMENT=local
RENDERER_ID=
RENDERER_CREDENTIAL_ID=
RENDERER_CLIENT_SECRET=
RENDERER_VERSION=minimax.20260904.local.1
RENDERER_REGISTER_MANIFEST=true
RENDERER_RESOLUTION=480P
RENDERER_CLIP_DURATION_SECONDS=5
